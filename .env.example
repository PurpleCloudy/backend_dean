# Copy only for your explicitly configured environment. Secrets have no defaults.
DATABASE_URL=postgresql://deanery_runtime:REPLACE@localhost:5432/deanery_app
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/deanery_app
JOB_DATABASE_URL=postgresql://deanery_jobs:REPLACE@localhost:5432/deanery_app
ACCESS_TOKEN_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
DELEGATION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
# Secure defaults; local_config.py opts into local HTTP explicitly.
DEVELOPMENT=false
ALLOWED_ORIGINS=["*"]
TRUSTED_PROXY_IPS=[]
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=100
LOGIN_WINDOW_SECONDS=300
AGENT_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=deanery-private
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=deanery_documents
BGE_URL=REPLACE_WITH_REAL_BGE_ENDPOINT
OPENAI_BASE_URL=REPLACE_WITH_REAL_OPENAI_COMPATIBLE_ENDPOINT
OPENAI_API_KEY=REPLACE_WITH_REAL_PROVIDER_KEY
OPENAI_MODEL=REPLACE_WITH_TOOL_CALLING_MODEL
# Deterministic local providers require explicit scripts/local_config.py --fixture-providers.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
