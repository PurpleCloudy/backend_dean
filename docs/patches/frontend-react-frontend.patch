+import { useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { api } from "../../api/client";
+import { getFile, type StoredFileSummary } from "../../api/files";
+import { Modal } from "../../components/ui";
+import { nextOffset, Pager, Problem, STATUS, useCursor, type CursorPage } from "../../pages/manage/common";
+import { attachmentProblem, attachmentWarning, versionMeta, acceptedExtensions, type AttachmentLimits } from "./policy";
+import type { AttachmentMeta } from "../store/ChatStore";
+
+export function AttachmentPicker({limits,onSelect,onClose}:{limits:AttachmentLimits;onSelect:(meta:AttachmentMeta)=>boolean;onClose:()=>void}) {
+ const cursor=useCursor();const [title,setTitle]=useState(''),[id,setId]=useState(''),[error,setError]=useState<unknown>(null);
+ const files=useQuery({queryKey:['files','attachment-picker',cursor.offset,title],queryFn:()=>api<CursorPage<StoredFileSummary>>('/files',{query:{limit:20,offset:cursor.offset,title}})});
+ const detail=useQuery({queryKey:['file',id],queryFn:()=>getFile(id),enabled:!!id,staleTime:0});
+ const next=files.data?nextOffset(files.data):null;
+ return <Modal label="Выбрать сохранённый документ" onClose={onClose}><div className="dialog form-dialog"><div className="form-head"><h3>Выбрать документ и версию</h3><button className="icon-btn" aria-label="Закрыть" onClick={onClose}>×</button></div><div className="form-body">
+ <p className="hint">Для текущей модели: {acceptedExtensions(limits).join(', ')}. До {limits.maxCount} файлов, {Math.round(limits.maxFile/1000000)} МБ каждый, {Math.round(limits.maxTotal/1000000)} МБ вместе. Отправляется именно выбранная версия.</p>
+ {!id&&<><label className="field">Название документа<input className="text-input" type="search" value={title} onChange={e=>{setTitle(e.target.value);cursor.reset();setId('');}}/></label><Problem error={files.error} retry={()=>files.refetch()}/>
+ {files.isFetching?<p>Загрузка документов…</p>:<div className="attachment-file-options">{files.data?.items.map(file=><button className={'btn'+(id===file.id?' soft':'')} key={file.id} onClick={()=>{setId(file.id);setError(null);}}>{file.title}<small>{file.latest_version?.filename??'Без версии'}</small></button>)}{files.data&&!files.data.items.length&&<p className="hint">На этой странице доступных документов нет.</p>}</div>}
+ <Pager offset={cursor.offset} next={next} back={()=>{setId('');cursor.back();}} forward={()=>{setId('');cursor.forward(next);}}/></>}
+ {id&&<section><button className="btn sm soft" autoFocus onClick={()=>{setId('');setError(null);}}>Назад к документам</button><h4>{detail.data?.title??'Версии документа'}</h4><Problem error={detail.error} retry={()=>detail.refetch()}/>{detail.isFetching?<p>Загрузка версий…</p>:detail.data?.versions.map(version=>{
+  const meta=version.state==='ready'?versionMeta(detail.data!,version):null;
+  const problem=meta?attachmentProblem(meta,limits):STATUS[version.state]??'Версия недоступна';
+  const warning=meta?attachmentWarning(meta,limits):null;
+  return <div className="attachment-version" key={version.id}><b>Версия {version.version}{version.id===detail.data!.active_version_id?' · активная':''}</b><span>{version.filename} · {Math.ceil(version.byte_size/1024)} КБ</span>{problem&&<p className="hint">{problem}</p>}{warning&&<p className="hint">{warning}</p>}<button className="btn sm" disabled={!limits.agentReads||!!problem} onClick={()=>{if(meta){if(onSelect(meta))onClose();else setError(new Error('Не удалось добавить версию. Она уже прикреплена или превышен лимит количества/размера.'));}}}>Прикрепить эту версию</button></div>;
+ })}</section>}<Problem error={error}/>
+ </div><div className="actions"><button className="btn" onClick={onClose}>Отмена</button></div></div></Modal>;
+}
