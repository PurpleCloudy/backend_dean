new file mode 100644
index 0000000..cf9236a
--- /dev/null
+++ b/frontend/src/chat/store/serverChatStore.ts
@@ -0,0 +1,50 @@
+import { api, ApiError } from "../../api/client";
+import type { Proposal, RunStatus } from "../../api/agent";
+import type { AttachmentMeta, Chat, ChatStore, ChatSummary } from "./ChatStore";
+
+interface SessionSummary { id: string; title: string; created_at: string; updated_at: string; preview: string; busy: boolean }
+interface Message {
+  id: string; run_id?: string | null; status?: RunStatus | null; role: "user" | "assistant" | "error"; content: string; created_at: string;
+  attachments: (Omit<AttachmentMeta, "size"> & { byte_size: number })[];
+  unavailable_attachment_count: number; unavailable_proposal_count: number; proposals: Proposal[]; tools_used: string[]; request_id: string | null;
+}
+interface SessionPage extends SessionSummary { messages: Message[]; next_offset: number | null }
+
+// Единственный источник истории — сервер; в браузере остаётся только выбор открытого чата.
+export const serverChatStore: ChatStore = {
+  async list() {
+    const items: ChatSummary[] = [];
+    let offset: number | null = 0;
+    while (offset !== null) {
+      const page: { items: SessionSummary[]; next_offset: number | null } = await api("/agent/sessions", { query: { limit: 100, offset } });
+      items.push(...page.items.map((s) => ({ id: s.id, title: s.title, updatedAt: s.updated_at, preview: s.preview })));
+      offset = page.next_offset;
+    }
+    return items;
+  },
+  async get(id) {
+    let offset: number | null = 0;
+    let chat: Chat | null = null;
+    try {
+      while (offset !== null) {
+        const page: SessionPage = await api(`/agent/sessions/${id}`, { query: { limit: 100, offset } });
+        chat ??= { id, sessionId: id, title: page.title, createdAt: page.created_at, updatedAt: page.updated_at, busy: page.busy, messages: [] };
+        chat.messages.push(...page.messages.map((m) => ({
+          id: m.id, role: m.role === "assistant" ? "agent" as const : m.role, text: m.content, at: m.created_at,
+          attachments: m.attachments.map((a) => ({ ...a, size: a.byte_size })),
+          unavailableAttachments: m.unavailable_attachment_count,
+          unavailableProposals: m.unavailable_proposal_count,
+          proposals: m.proposals, tools: m.tools_used, requestId: m.request_id ?? undefined, runId: m.run_id ?? undefined, runStatus: m.status ?? undefined,
+          decisions: Object.fromEntries(m.proposals.filter((p) => p.status !== "pending").map((p) => [p.id, p.status as "approved" | "rejected"])),
+        })));
+        offset = page.next_offset;
+      }
+      return chat;
+    } catch (e) {
+      if (e instanceof ApiError && e.status === 404) return null;
+      throw e;
+    }
+  },
+  async rename(id, title) { await api(`/agent/sessions/${id}`, { method: "PATCH", json: { title } }); },
+  async remove(id) { await api(`/agent/sessions/${id}`, { method: "DELETE" }); },
+};
