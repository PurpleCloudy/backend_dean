+export function ReportsPage(){const {data:schema,error}=useSchema();const names=Object.keys(schema??{}).filter(n=>schema![n].kind==='view');const [id,setId]=useState('');const selected=names.includes(id)?id:names[0];return <Page title="Отчёты и выгрузки"><ManageNav/><Problem error={error}/>{selected&&<><label className="field">Отчёт<select className="select" value={selected} onChange={e=>setId(e.target.value)}>{names.map(n=><option key={n} value={n}>{resourceName(n)}</option>)}</select></label><Report key={selected} name={selected} spec={schema![selected]}/></>}</Page>;}
+function Report({name,spec}:{name:string;spec:ResourceSpec}){const [filters,setFilters]=useState<ResourceFilter[]>([]),[sort,setSort]=useState(''),[desc,setDesc]=useState(false),[limit,setLimit]=useState(100),[rows,setRows]=useState<Row[]|null>(null),[busy,setBusy]=useState(false),[error,setError]=useState<unknown>(null),[job,setJob]=useState<string|null>(null);async function run(exporting=false){setBusy(true);setError(null);setJob(null);try{const parameters=reportParams(filters,spec,sort,desc);if(exporting){const j=await action<{id:string}>('/exports',{report:name,filters:parameters,limit});setJob(j.id);}else{const r=await api<{items:Row[]}>('/reports/'+name,{query:{...parameters,limit:Math.min(limit,500)}});setRows(r.items);}}catch(e){setError(e);}finally{setBusy(false);}}const changed=()=>{setRows(null);setJob(null);};return <section className="manage-panel"><h2>{resourceName(name)}</h2><fieldset className="report-controls" disabled={busy}><ResourceFilters spec={spec} filters={filters} setFilters={update=>{changed();setFilters(update);}}/><div className="manage-actions"><label className="field">Сортировка<select className="select" value={sort} onChange={e=>{changed();setSort(e.target.value);}}><option value="">По умолчанию</option>{spec.read_fields.map(k=><option key={k} value={k}>{label(k,spec)}</option>)}</select></label><label className="check"><input type="checkbox" checked={desc} onChange={e=>{changed();setDesc(e.target.checked);}}/>По убыванию</label><label className="field">Максимум строк<input className="text-input" type="number" min={1} max={10000} value={limit} onChange={e=>{changed();setLimit(Number(e.target.value));}}/></label><button className="btn primary" disabled={busy||limit<1||limit>10000} onClick={()=>run()}>Показать</button><button className="btn" disabled={busy||limit<1||limit>10000} onClick={()=>run(true)}>Выгрузить CSV</button></div></fieldset><p className="hint">Предпросмотр показывает первые {Math.min(limit,500)} строк. Выгрузка включает