+export function RunDialog({id,onClose}:{id:string;onClose:()=>void}){const {role,me}=useAuth();const q=useQuery({queryKey:['agent-run',id],queryFn:()=>api<Run>(`/agent/runs/${id}`),refetchInterval:5000});const [reason,setReason]=useState(''),[terminated,setTerminated]=useState(false),[confirm,setConfirm]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState<unknown>(null);const [showFiles,setShowFiles]=useState(false);const files=useQuery({queryKey:['run-attachments',id],queryFn:()=>api<{attachments:{file_id:string;version_id:string;title:string;filename:string}[]}>(`/agent/runs/${id}/attachments`),enabled:showFiles});async function recover(){setBusy(true);setError(null);try{await api(`/agent/runs/${id}/recover`,{json:{reason:reason.trim(),instance_terminated:terminated}});setConfirm(false);await q.refetch();}catch(e){setError(e);}finally{setBusy(false);}}return <Modal label="Состояние запроса агента" onClose={onClose}><div className="dialog form-dialog"><div className="form-head"><h3>Состояние запроса агента</h3><button className="icon-btn" aria-label="Закрыть" disabled={busy} onClick={onClose}>×</button></div><div className="form-body"><Problem error={q.error}/>{q.data&&<><p>{names[q.data.status]}</p><p className="hint">Начат: {new Date(q.data.created_at).toLocaleString('ru')}{q.data.completed_at&&` · Завершён: ${new Date(q.data.completed_at).toLocaleString('ru')}`}</p>{q.data.user_id===me?.user_id&&<button className="btn" onClick={()=>setShowFiles(true)}>Документы этого запроса</button>}{showFiles&&<><Problem error={files.error}/>{files.data?.attachments.map(a=><p key={a.version_id}><Link to={`/files?file=${a.file_id}`} onClick={onClose}>{a.title||a.filename}</Link></p>)}{files.data&&!files.data.attachments.length&&<p className="hint">В этом запросе вложений нет.</p>}</>}{role==='admin'&&['running','ambiguous'].includes(q.data.status)&&<><h3>Снять блокировку после остановки агента</h3><p>Сначала остановите экземпляр агента, который обслуживал запрос, и проверьте результаты его операций. Эта кнопка не останавливает процесс: она отмечает запрос завершённым с ошибкой.</p><label className="field">Основание восстановления<textarea className="text-input" minLength={10} maxLength={1000} value={reason} onChange={e=>setReason(e.target.value)}/></label><label className="check"><input type="checkbox" checked={terminated} onChange={e=>setTerminated(e.target.checked)}/>Подтверждаю: обслуживавший запрос экземпляр агента остановлен</label><button className="btn" disabled={busy||!terminated||reason.trim().length<10} onClick={()=>setConfirm(true)}>Снять блокировку</button></>}</>}<Problem error={error}/></div></div>{confirm&&<ConfirmDialog title="Снять блокировку запроса?" text="Запрос будет отмечен завершённым с ошибкой. Используйте это только после подтверждённой остановки обслуживавшего его экземпляра агента." confirm="Подтверждаю восстановление" busy={busy} onConfirm={recover} onCancel={()=>setConfirm(false)}/>}</Modal>;}
+
+export const isRunCode=(value:string)=>/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value.trim());
+export function RunSupportLookup(){
+ const {role}=useAuth();const [code,setCode]=useState(''),[selected,setSelected]=useState<string|null>(null),[error,setError]=useState<unknown>(null);
+ if(role!=='admin')return null;
+ return <section className="manage-panel"><h2>Помощь с запросом агента</h2><p className="hint">Код запроса берётся из сообщения об ошибке пользователя. Просмотр не останавливает агент и не меняет результат.</p><form className="manage-actions" onSubmit={e=>{e.preventDefault();setError(null);if(!isRunCode(code)){setError(new Error('Введите полный код запроса в формате UUID'));return;}setSelected(code.trim());}}><label className="field">Код запроса агента<input className="text-input" value={code} onChange={e=>setCode(e.target.value)} required placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/></label><button className="btn">Найти запрос по коду</button></form><Problem error={error}/>{selected&&<RunDialog id={selected} onClose={()=>setSelected(null)}/>}</section>;
+}
