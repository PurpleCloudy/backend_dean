+import type { Dispatch, SetStateAction } from "react";
+import type { ResourceSpec } from "../../api/schema";
+import type { Params } from "../../api/resources";
+import { Field, fromInput, kindOf } from "../../components/form/fields";
+import { label } from "./catalog";
+export type ResourceFilter = {field:string;op:string;value:string|boolean};
+export function reportParams(filters:{field:string;op:string;value:string|boolean}[],spec:ResourceSpec,sort:string,desc:boolean):Params {
+ const result:Params={};
+ for(const filter of filters){const key=filter.field+'__'+filter.op;if(key in result)throw new Error('Условие для этого поля и сравнения уже добавлено');if(filter.value===''||filter.value==null)throw new Error('Заполните значения условий');result[key]=fromInput(filter.value,kindOf(filter.field,spec.fields[filter.field]),spec.fields[filter.field]) as Params[string];}
+ if(sort)result.sort=(desc?'-':'')+sort;
+ return result;
+}
+export function ResourceFilters({filters,setFilters,spec}:{filters:ResourceFilter[];setFilters:Dispatch<SetStateAction<ResourceFilter[]>>;spec:ResourceSpec}) {
+ return <>{filters.map((f,i)=><div className="filter-row resource-filter" key={i}><select className="select" aria-label={`Поле условия ${i+1}`} value={f.field} onChange={e=>{setFilters(fs=>fs.map((v,n)=>n===i?{...v,field:e.target.value,value:''}:v));}}>{spec.read_fields.map(k=><option key={k} value={k}>{label(k,spec)}</option>)}</select><select className="select" aria-label={`Сравнение ${i+1}`} value={f.op} onChange={e=>{setFilters(fs=>fs.map((v,n)=>n===i?{...v,op:e.target.value}:v));}}>{[['eq','Равно'],['ne','Не равно'],['lt','Меньше'],['lte','Не больше'],['gt','Больше'],['gte','Не меньше']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select><Field name={'report_'+i} spec={spec.fields[f.field]} value={f.value} label="Значение" onChange={value=>{setFilters(fs=>fs.map((v,n)=>n===i?{...v,value}:v));}}/><button className="btn sm" onClick={()=>{setFilters(fs=>fs.filter((_,n)=>n!==i));}}>Удалить условие</button></div>)}<button className="btn" disabled={filters.length>=12} onClick={()=>{setFilters(fs=>[...fs,{field:spec.read_fields[0],op:'eq',value:''}]);}}>Добавить условие</button></>;
+}
