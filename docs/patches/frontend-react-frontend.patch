+export function PrivatePersonDialog({personId,onClose}:{personId:number;onClose:()=>void}){const q=useQuery({queryKey:['private-person',personId],queryFn:()=>api<Row>(`/people/${personId}/private`),gcTime:0});const {data:schema}=useSchema();const can=useCan();const {role}=useAuth();const students=useResource('student',{person_id:personId},role!=='admin'&&can('person','update'));const editable=can('person','update')&&(role==='admin'||!!students.data?.length);const spec=schema?.person;const [editing,setEditing]=useState(false),[values,setValues]=useState<Values>({}),[busy,setBusy]=useState(false),[error,setError]=useState<unknown>(null);const [ask,setAsk]=useState(false),[dirty,setDirty]=useState(false),[errors,setErrors]=useState<Record<string,string>>({});const close=()=>dirty?setAsk(true):onClose();const qc=useQueryClient(),toast=useToast();const fields=Object.keys(q.data??{}).filter(k=>k!=='person_id'&&spec?.fields[k]).map(k=>[k,spec!.fields[k]] as const);useEffect(()=>{if(q.data&&spec)setValues(rowToValues(q.data,Object.keys(q.data).filter(k=>k!=='person_id'&&spec.fields[k]).map(k=>[k,spec.fields[k]])));},[q.data,spec]);async function save(){const problems:Record<string,string>={};for(const[k,sp]of fields){const problem=checkField(k,sp,values[k]??'',!sp.nullable&&sp.default==null);if(problem)problems[k]=problem;}setErrors(problems);if(Object.keys(problems).length)return;setBusy(true);setError(null);try{const patch:Row={};for(const[k,sp]of fields){const v=fromInput(values[k],kindOf(k,sp),sp);if(v!==q.data?.[k])patch[k]=v;}if(Object.keys(patch).length)await updateRow('person',{person_id:personId},patch);await qc.invalidateQueries({queryKey:['res','person']});await q.refetch();setDirty(false);setEditing(false);toast('Личные сведения сохранены');}catch(e){setError(e);}finally{setBusy(false);}}return <><Modal label="Личные сведения" onClose={close} outsideClose={false}><div className="dialog form-dialog"><div className="form-head"><h3>Личные сведения</h3><button className="icon-btn" aria-label="Закрыть" disabled={busy} onClick={close}>×</button></div><div className="form-body"><p className="hint">Доступ проверяется отдельно. Эти сведения не включаются в общие таблицы.</p>{q.isLoading?<p>Загрузка…</p>:q.error?<ErrorNote text={errorText(q.error)}/>:editing?<div className="form-grid">{fields.map(([k,sp])=><Field key={k} name={k} spec={sp} value={values[k]??''} onChange={v=>{setDirty(true);setErrors(e=>{const{[k]:_,...rest}=e;return rest;});setValues(s=>({...s,[k]:v}));}} error={errors[k]} disabled={busy}/>)}</div>:<dl className="record-details">{fields.map(([k])=><div key={k}><dt>{label(k,spec)}</dt><dd>{labelOf(q.data?.[k])}</dd></div>)}</dl>}{!!error&&<ErrorNote text={errorText(error)}/>}</div><div className="actions">{editable&&!q.error&&q.data&&(editing?<button className="btn primary" disabled={busy} onClick={save}>Сохранить</button>:<button className="btn" onClick={()=>setEditing(true)}>Изменить</button>)}<button className="btn" disabled={busy} onClick={editing?close:onClose}>{editing?'Отмена':'Закрыть'}</button></div></div></Modal>{ask&&<UnsavedDialog onSave={()=>{setAsk(false);save();}} onDiscard={onClose} onCancel={()=>setAsk(false)}/>}</>;}
